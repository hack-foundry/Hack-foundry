# Copy to .env.local for local dev. On Vercel, add these under Project → Settings → Environment Variables.
# Everything is optional: with nothing set, the site runs in demo mode (no real payments, waitlist logged only).

# Your public URL, e.g. https://rootwellhealth.com (used for Stripe return links + SEO)
NEXT_PUBLIC_SITE_URL=

# Stripe (use sk_test_... while testing, sk_live_... to take real payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to "true" once you've set up Stripe Tax (handles VAT/GST/sales tax worldwide)
STRIPE_AUTOMATIC_TAX=false

# Supabase (stores waitlist sign-ups and orders). Service role key is SERVER-ONLY — never expose it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Country used when no geo header is present (local dev)
DEFAULT_COUNTRY=US
# Allow ?country=XX to preview other countries' pricing. Keep false in production.
ALLOW_COUNTRY_OVERRIDE=false
